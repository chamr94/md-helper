<?xml version="1.0" encoding="utf-8"?>
<!-- MD 도우미: MacroDroid가 못 하는 일을 대신하는 작은 앱 (tools/build_helper.sh로 빌드) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.mdhelper.app">

    <!-- 차 블루투스 목록: 등록 기기의 이름·종류를 읽음 (Android 12+ 실행 중 권한 — 상태 화면 버튼이나 adb pm grant로 줌) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />

    <!-- 스스로 업데이트: 매크로가 받은 새 APK로 이 앱만 업데이트함 (UpdateActivity — 다른 앱은 설치하지 않음) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- 안드로이드 12+: 자기 자신을 업데이트할 때 확인 창 없이 (SessionParams.USER_ACTION_NOT_REQUIRED — 이 권한을 적어야 받아들여짐) -->
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />

    <!-- 알림을 못 찾았을 때 그 앱을 열려면 다른 앱의 실행 화면을 볼 수 있어야 함 (Android 11+ 패키지 공개 범위) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- 글자: res/values(영어 기본)·values-ko(한국어). 앱별 언어(안드로이드 13+): res/xml/locales_config.xml -->
    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config">

        <!-- 상태 화면: 알림 접근 권한, 담아 둔 알림 수 -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MacroDroid가 부르는 투명 화면: 담아 둔 알림을 찾아 그 알림을 누른 것처럼 엶 -->
        <activity
            android:name=".OpenActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="com.mdhelper.OPEN_NOTIFICATION" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 스스로 업데이트: MacroDroid '파일 열기'(받는 곳을 이 화면으로 정함)로 받은 새 APK(content://)를 넘기면 이 앱만 업데이트하는
             투명 화면. 다른 APK 파일의 '열기' 목록에 나오지 않게 인텐트 필터는 두지 않음 -->
        <activity
            android:name=".UpdateActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 차 블루투스 목록: MacroDroid 셸이 am broadcast (user 0, 받는 곳 com.mdhelper.app/.CarReceiver)로 부르면 'CARS=이름|이름'으로 답함 -->
        <receiver
            android:name=".CarReceiver"
            android:exported="true" />

        <!-- 기압계: 같은 방법으로 부르면 1.5초 동안 읽은 기압의 가운데 값을 'P=hPa;N=개수'로 답함 (주차 층 짐작) -->
        <receiver
            android:name=".PressureReceiver"
            android:exported="true" />

        <!-- 알림 전달(메시지 알리미): 거르기 정규식을 받거나(SET_FILTER) 매크로가 하나를 다 처리했다는 알림(ACK)을 받거나 상태를 'FWD=;L=;V=;N='으로 답함 -->
        <receiver
            android:name=".FwdReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.mdhelper.SET_FILTER" />
                <action android:name="com.mdhelper.ACK" />
            </intent-filter>
        </receiver>

        <!-- 자동응답: 넘긴 알림의 답장 칸에 글자를 넣어 보냄(REPLY + key·text) -->
        <receiver
            android:name=".ReplyReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.mdhelper.REPLY" />
            </intent-filter>
        </receiver>

        <!-- 보안 잠금 빠른 덮개: 잠근 앱이 앞에 오는 순간 덮개를 그림(접근성 — 창이 바뀌는 것만 받고 화면 내용은 읽지 않음) -->
        <service
            android:name=".LockService"
            android:exported="true"
            android:label="@string/lock_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/lock_service" />
        </service>

        <!-- 보안 잠금 매크로가 잠글 앱·유예·통과를 알려 줌(SET_LOCK·LOCK_ASK·LOCK_PASS·LOCK_SKIP) -->
        <receiver
            android:name=".LockReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.mdhelper.SET_LOCK" />
                <action android:name="com.mdhelper.LOCK_PASS" />
                <action android:name="com.mdhelper.LOCK_ASK" />
                <action android:name="com.mdhelper.LOCK_SKIP" />
            </intent-filter>
        </receiver>

        <!-- 알림 접근: 알림이 올 때마다 여는 방법(PendingIntent)을 메모리에 담아 둠 -->
        <service
            android:name=".NotiService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
